<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/headerProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/txtProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Мой профиль: Vlad"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/txtProfileBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Баланс: 0 руб."
            android:textSize="18sp"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestMoney"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Тест: +1 000 000 руб."
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="#4CAF50"
            app:strokeColor="#4CAF50"
            android:layout_marginTop="4dp"
            android:textSize="10sp"
            app:cornerRadius="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ваши объявления и покупки:"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMyCars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerProfile"
        android:layout_above="@+id/layoutButtons"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/txtEmptyProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="У вас пока нет активных объявлений или покупок."
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:padding="16dp"
        android:background="@android:color/white"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToFeed"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:text="В ленту"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@android:color/black"
            app:strokeColor="#CCCCCC"
            app:cornerRadius="8dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCar"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:text="+ Продать"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"
            android:textSize="14sp" />
    </LinearLayout>

</RelativeLayout>